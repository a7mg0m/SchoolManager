<?xml version="1.0" encoding="utf-8"?>
<!--
  Keeps NuGet packages on drive D: for this solution (drive C: is full).
  Delete this file to go back to the default folder (%USERPROFILE%\.nuget\packages).
-->
<configuration>
  <config>
    <add key="globalPackagesFolder" value="D:\NuGet\packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
