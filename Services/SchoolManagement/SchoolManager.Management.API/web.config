<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <!--
          IIS / IIS Express reject bodies over ~28.6 MB by default. The school album uploads videos up to 100 MB,
          so IIS lets requests up to 110 MB (115343360 bytes) through. ASP.NET Core still limits every endpoint to
          its default 30 MB, except the album upload ([RequestSizeLimit] on SchoolInfosController.UploadAlbum).
        -->
        <requestLimits maxAllowedContentLength="115343360" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
