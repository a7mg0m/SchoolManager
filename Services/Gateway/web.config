<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <!--
          IIS / IIS Express reject bodies over ~28.6 MB by default. School album uploads (videos up to 100 MB) pass
          through the gateway, so IIS lets requests up to 110 MB (115343360 bytes) through. The gateway still limits
          every route to the default 30 MB, except "management-album-upload-route" (MaxRequestBodySize in ReverseProxy.json).
        -->
        <requestLimits maxAllowedContentLength="115343360" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
