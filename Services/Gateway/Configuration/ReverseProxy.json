{
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/{resource:regex(^(role|user|user-profile|employee|employee-group|menu-item|group-permission)$)}/{**catch-all}" },
        "Transforms": [ { "RequestHeader": "Host", "Set": "localhost:59463" } ]
      },
      "management-route": {
        "ClusterId": "management-cluster",
        "Match": { "Path": "/api/{resource:regex(^(semester|section|timetable-slot|school-info|timetable|parent|teacher|grade|academic-year|subject|stage|student|vaccine|vaccination-campaign|student-vaccination|clinic-visit|student-medical-profile)$)}/{**catch-all}" },
        "Transforms": [ { "RequestHeader": "Host", "Set": "localhost:5298" } ]
      },
      "management-album-upload-route": {
        "ClusterId": "management-cluster",
        "Order": -1,
        "MaxRequestBodySize": 115343360,
        "Match": { "Path": "/api/school-info/album/upload", "Methods": [ "POST", "OPTIONS" ] },
        "Transforms": [ { "RequestHeader": "Host", "Set": "localhost:5298" } ]
      },
      "management-upload-route": {
        "ClusterId": "management-cluster",
        "Match": { "Path": "/upload/{**catch-all}" },
        "Transforms": [ { "RequestHeader": "Host", "Set": "localhost:5298" } ]
      },
      "examshomework-route": {
        "ClusterId": "examshomework-cluster",
        "Match": { "Path": "/api/{resource:regex(^(exam|exam-result|homework|homework-question|homework-publish)$)}/{**catch-all}" },
        "Transforms": [ { "RequestHeader": "Host", "Set": "localhost:5180" } ]
      },
      "notification-files-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/notification-files/{**catch-all}" },
        "Transforms": [ { "RequestHeader": "Host", "Set": "localhost:5233" } ]
      },
      "notification-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/api/{resource:regex(^(notification|notification-target|school-event|event-target|chat|devices)$)}/{**catch-all}" },
        "Transforms": [ { "RequestHeader": "Host", "Set": "localhost:5233" } ]
      },
      "financial-route": {
        "ClusterId": "financial-cluster",
        "Match": { "Path": "/api/{resource:regex(^(fee|student-fee|payment|payment-method|expense|expense-category|revenue|revenue-category)$)}/{**catch-all}" },
        "Transforms": [ { "RequestHeader": "Host", "Set": "localhost:5128" } ]
      },
      "attendance-route": {
        "ClusterId": "attendance-cluster",
        "Match": { "Path": "/api/{resource:regex(^(daily-attendance|student-evaluation|evaluation-request|bus-route|bus|bus-assignment|trip|attendance-dashboard)$)}/{**catch-all}" },
        "Transforms": [ { "RequestHeader": "Host", "Set": "localhost:5170" } ]
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-api": { "Address": "http://localhost:59463/" }
        }
      },
      "management-cluster": {
        "Destinations": {
          "management-api": { "Address": "http://localhost:5298/" }
        }
      },
      "examshomework-cluster": {
        "Destinations": {
          "examshomework-api": { "Address": "http://localhost:5180/" }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "notification-api": { "Address": "http://localhost:5160/" }
        }
      },
      "financial-cluster": {
        "Destinations": {
          "financial-api": { "Address": "http://localhost:5110/" }
        }
      },
      "attendance-cluster": {
        "Destinations": {
          "attendance-api": { "Address": "http://localhost:5170/" }
        }
      }
    }
  }
}
